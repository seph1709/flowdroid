<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SMS Trigger and Send SMS; asked for at runtime from Settings → Phone access. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <!-- Phone Event Trigger: Wi-Fi changes and boot. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Wake-up alarm for schedules; Android 14+ asks the user (Settings → Background setup). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Optional ("Display over other apps"): lets Open URL work while FlowDroid is in the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Phone Calendar, Calendar Event Trigger, Contacts and Speech to Text; asked for when first used. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Sound Mode: Do Not Disturb, granted by the person in Android settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- Alarm & Timer, through the phone's clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <!-- No CAMERA permission on purpose: declaring it would stop the camera app from taking photos for FlowDroid. -->

    <!-- The app picker (Notification Trigger) lists apps that have a launcher icon. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK"/>
            <data android:mimeType="vnd.android.cursor.dir/phone_v2"/>
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER"/>
        </intent>
    </queries>

    <application>
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <receiver android:name=".WakeAlarm" android:exported="false"/>
        <receiver android:name=".AskActions$AskReceiver" android:exported="false"/>
        <!-- The in-app browser on screen: watching a Browser step, or logging in to a site. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:label="Browser"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.flowdroid.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/flowdroid_file_paths" />
        </provider>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <service
            android:name=".NotificationWatcher"
            android:exported="true"
            android:label="FlowDroid"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <service
            android:name=".RunTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_media_play"
            android:label="Run FlowDroid"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
    </application>
</manifest>
